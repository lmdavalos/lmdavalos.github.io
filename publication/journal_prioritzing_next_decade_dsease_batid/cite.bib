@article{RN29067,
   author = {Kettenburg, Gwenddolen and Simonis, Molly C. and Ferretti, Pamela and Sánchez, Cecilia A. and Gaucherand, Léa and Williams, Kalani M. and Islam, Shariful and Lutz, Holly L. and Frank, Lexi E. and Huntington, Caleb A. and Juman, Maya M. and Mols, Vera C. and Quintela-Tizon, Rita M. and Voirin, Charlie J. and Ansil, B. R. and Vicente-Santos, Amanda and Víquez-R, Luis and Lelli, Davide and Phelps, Kendra L. and Weinberg, Maya and Woodson, Sara E. and Barker, Brianne R. and Dávalos, Liliana M. and Kingston, Tigga and Schmidt, Aaron G. and Streicker, Daniel G. and Uelmen, Johnny and Banerjee, Arinjay and Frank, Hannah K. and Seifert, Stephanie N. and Becker, Daniel J. and Brook, Cara E.},
   title = {Prioritizing the next decade of research in bat infectious disease (batID)},
   journal = {Nature Communications},
   volume = {17},
   number = {1},
   pages = {11919},
   abstract = {Bats are widely studied as asymptomatic hosts of viruses that cause high case fatality rates in humans. Though prior research into bat infections has been traditionally virus-focused, there is growing interest to more holistically understand bat-microbe relationships. In July 2025 the fourth International Symposium on the Infectious Diseases of Bats (‘BatID 2025’) convened, synthesizing the current state of bat-microbe research from within-host to population-level processes. Here, we outline five questions that emerged from this meeting as priority future directions. We share this review with the aim of stimulating future research, emphasizing the need for data sharing and interdisciplinary collaboration.},
   ISSN = {2041-1723},
   DOI = {10.1038/s41467-026-79693-1},
   url = {https://doi.org/10.1038/s41467-026-79693-1},
   year = {2026},
   type = {Journal Article}
}

