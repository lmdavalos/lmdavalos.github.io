@article {Liu2026.07.24.740446,
	author = {Liu, Shenglin and Freitas, Mariella Bontempo and Sartori, Sirlene Souza Rodrigues and Albertini, Michele and Leushkin, Evgeny and van Tussenbroek, Ine Alvarez and Morales, Ariadna E. and Pippel, Martin and Brown, Tom and de Sousa, Alex Filipe Ramos and de Paula, Rosin{\'e}a Aparecida and Patmanidis, Ilias and Jespers, Willem and Hilgers, Leon and Yi, Xueling and Bein, Bernhard and Malovichko, Yury and Schell, Tilman and Greve, Carola and Winkler, Sylke and Hamadou, Alexander Ben and Blumer, Moritz and Prange, Gisa and Cueria, Julio C{\'e}sar Hechavarria and K{\"o}ssl, Manfred and Winter, York and Dilrosun, Sean and Bechan, Stephert Dani{\"e}l and Engstrom, Mark D. and Jafferally, Deirdre and Norman, Zacharias and Sornoza, Francisco and D{\'a}valos, Liliana M. and Lim, Burton K. and Vernes, Sonja C. and Hiller, Michael},
	title = {Integrated genomics and transcriptomics reveal mechanisms of extreme dietary adaptation in vampire bats},
	elocation-id = {2026.07.24.740446},
	year = {2026},
	doi = {10.64898/2026.07.24.740446},
	publisher = {Cold Spring Harbor Laboratory},
	abstract = {Vampire bats are the only tetrapods that feed exclusively on blood. To uncover the molecular basis of this extreme dietary specialization, we generated six new reference genomes, including genomes of all three vampire bat species, and integrated comparative analyses of gene sequence evolution (selection signatures, duplications, and losses) with transcriptomic data from six major organs to identify shifts in gene expression. Our integrative analyses reveal sequence or expression changes in 150 genes that illuminate the genetic mechanisms underlying sanguivory. Through comparative analyses and experiments, we show that the enlarged vampire bat stomach has increased connective tissue content enabling extreme expansion, is pH-neutral, and exhibits reduced mucus production, together providing molecular insights into its shift from a digestive to an absorptive organ for water, electrolytes, and vitamins. We further uncover pathway-level molecular changes underlying altered gastrointestinal motility; trypsin-dependent protein digestion; upregulated amino acid catabolism with key aspects diverging from other mammals; impaired dietary fat digestion counterbalanced by increased fatty acid synthesis; defective sugar metabolism and natural insulin deficiency; enhanced heme iron absorption; and adult splenic erythropoiesis. Together, these findings reveal the molecular adaptations that enable one of the most extreme dietary transitions among vertebrates.Competing Interest StatementThe authors have declared no competing interest.},
	URL = {https://www.biorxiv.org/content/early/2026/07/24/2026.07.24.740446},
	eprint = {https://www.biorxiv.org/content/early/2026/07/24/2026.07.24.740446.full.pdf},
	journal = {bioRxiv}
}
